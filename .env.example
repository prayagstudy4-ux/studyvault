# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Both values are PUBLIC by design (safe for browsers) — security is enforced
# by Row Level Security in the database. Never add the service_role key here.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
