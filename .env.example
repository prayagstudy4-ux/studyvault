# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Both values are PUBLIC by design (safe for browsers) — security is enforced
# by Row Level Security in the database. Never add the service_role key here.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Google Drive credentials (for Edge Functions only - DO NOT commit real values)
# These must be set as Supabase Edge Function secrets, NOT in .env.local
# Run: supabase secrets set GOOGLE_CLIENT_ID=xxx GOOGLE_CLIENT_SECRET=xxx GOOGLE_REFRESH_TOKEN=xxx
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
